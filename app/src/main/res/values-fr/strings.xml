    <string name="private_browsing_title">Navigation privée</string>
    <string name="private_browsing_body">&lt;h1&gt;Navigation privée&lt;/h1&gt;
&lt;p&gt;Lorsque vous naviguez dans une fenêtre privée, le navigateur Midori &lt;strong&gt;n\'enregistre pas&lt;/strong&gt; :&lt;/p&gt;
&lt;ul class="two-column"&gt;
    &lt;li&gt;pages visitées&lt;/li&gt;
    &lt;li&gt;recherches&lt;/li&gt;
    &lt;li&gt;cookies&lt;/li&gt;
    &lt;li&gt;fichiers temporaires&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Navigation privée &lt;strong&gt;ne\'ne vous rend pas anonyme&lt;/strong&gt; sur Internet. Votre employeur ou votre fournisseur de services Internet peut toujours savoir quelle page vous visitez.&lt;/p&gt;
&lt;p class="about-info"&gt;En savoir plus sur &lt;a id="learnMore"&gt;Navigation privée&lt;/a&gt;.&lt;/p&gt;
     </string>
    <string name="datareporting_notification_title">Navigateur Midori</string>
    <string name="datareporting_notification_summary">Pour améliorer votre expérience, Midori Browser envoie automatiquement certaines informations à Astian.</string>
    <string name="default_notification_channel">Navigateur</string>
    <string name="about_content">&lt;p&gt;%1$s vous donne le contrôle.&lt;/p&gt;
&lt;p&gt;Utilisez-le comme référence pour :
    &lt;br&gt;• Apprenez à créer votre propre navigateur.
    &lt;br&gt;• Contribuez à faciliter la création de navigateurs.
    &lt;br&gt;• Déposez des rapports de bogues !
&lt;/p&gt;
&lt;p&gt;%1$s est produit par Astian. Notre mission est de favoriser un Internet sain et ouvert.&lt;br/&gt;
    </string>
