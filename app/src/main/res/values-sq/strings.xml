    <string name="private_browsing_title">Shfletim Privat</string>
    <string name="private_browsing_body">&lt;h1&gt;Shfletim privat&lt;/h1&gt;
&lt;p&gt;Kur shfletoni në një dritare private, shfletuesi Midori &lt;strong&gt;nuk ruan&lt;/strong&gt;:&lt;/p&gt;
&lt;ul class="two-column"&gt;
    &lt;li&gt;faqet e vizituara&lt;/li&gt;
    &lt;li&gt;kërkimet&lt;/li&gt;
    &lt;li&gt; biskota&lt;/li&gt;
    &lt;li&gt;skedarët e përkohshëm&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Shfletimi privat &lt;strong&gt;nuk\' ju bën anonim&lt;/strong&gt; në internet. Punëdhënësi ose ofruesi juaj i shërbimit të internetit mund të dinë ende se cilën faqe vizitoni.&lt;/p&gt;
&lt;p class="about-info"&gt;Mëso më shumë rreth &lt;a id="learnMore"&gt;Shfletim privat&lt;/a&gt;.&lt;/p&gt;
     </string>
    <string name="datareporting_notification_title">Shfletuesi Midori</string>
